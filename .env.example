# APGI Learning Portal environment contract
# Copy to .env.local for local development. Do not commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PRIVATE_FILE_BUCKET=

# App URL / deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email (Resend)
# Keep both values server-only. Verify the sender domain in Resend before enabling live delivery.
RESEND_API_KEY=
EMAIL_FROM=

# Stripe payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AIMC Gateway
AIMC_GATEWAY_URL=
AIMC_GATEWAY_API_KEY=

# Certificate generation / signing
CERTIFICATE_SIGNING_SECRET=

# Evidence and CWT controls
ALP_EVIDENCE_BASE_PATH=modules/ALP/11-build/evidence
ALP_CWT_BASE_URL=

# Hosted Scannex practical (Ireland). Keep disabled until the native validation gates pass.
SCANNEX_LIVE_ENABLED=false
# Vercel OIDC role limited to the assessment stack/fleet; no permanent AWS access keys.
SCANNEX_AWS_ROLE_ARN=
SCANNEX_AWS_STACK=
SCANNEX_AWS_FLEET=
SCANNEX_AWS_APPLICATION=
# Set only for a collector that has passed real-export and isolation validation.
SCANNEX_VERIFIED_ADAPTER_VERSION=
# Random secret of at least 32 characters, shared only with the protected Windows collector service.
SCANNEX_COLLECTOR_SECRET=
