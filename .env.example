# APGI Learning Portal environment contract
# Copy to .env.local for local development. Do not commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PRIVATE_FILE_BUCKET=

# App URL / deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AIMC Gateway
AIMC_GATEWAY_URL=
AIMC_GATEWAY_API_KEY=

# Certificate generation / signing
CERTIFICATE_SIGNING_SECRET=

# Evidence and CWT controls
ALP_EVIDENCE_BASE_PATH=modules/ALP/11-build/evidence
ALP_CWT_BASE_URL=
