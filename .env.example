# APGI Learning Portal environment contract
# Copy to .env.local for local development. Do not commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PRIVATE_FILE_BUCKET=

# App URL / deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email (Resend)
# Keep both values server-only. Verify the sender domain in Resend before enabling live delivery.
RESEND_API_KEY=
EMAIL_FROM=

# Stripe payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AIMC Gateway
AIMC_GATEWAY_URL=
AIMC_GATEWAY_API_KEY=

# Certificate generation / signing
CERTIFICATE_SIGNING_SECRET=

# Evidence and CWT controls
ALP_EVIDENCE_BASE_PATH=modules/ALP/11-build/evidence
ALP_CWT_BASE_URL=

# Hosted Scannex Viewer Lab
# AWS WorkSpaces Applications (AppStream 2.0). These values are server-only.
# The application uses the AWS SDK credential chain. Never expose AWS credentials as NEXT_PUBLIC values.
SCANNEX_VIEWER_LAB_ENABLED=false
SCANNEX_VIEWER_LAB_REGION=eu-west-1
SCANNEX_VIEWER_LAB_STACK_NAME=
SCANNEX_VIEWER_LAB_FLEET_NAME=
SCANNEX_VIEWER_LAB_APPLICATION_ID=
# ARN of the least-privilege AWS role trusted by Vercel OIDC. No access keys are stored.
AWS_ROLE_ARN=
# The URL itself is single-use and short-lived. 60 seconds is the default.
SCANNEX_VIEWER_LAB_SESSION_TTL_SECONDS=60
